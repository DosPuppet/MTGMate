{
  "name": "mtgx",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mtgx/client",
    "build": "npm run build -w @mtgx/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fuzz": "tsx tools/fuzz.ts",
    "golden": "tsx tools/golden.ts",
    "arena": "tsx tools/ai-arena.ts",
    "verify": "tsx tools/verify.ts",
    "import-cards": "tsx tools/import-scryfall.ts",
    "import-tokens": "tsx tools/import-tokens.ts",
    "import-printings": "tsx tools/import-printings.ts",
    "custom-art": "tsx tools/custom-art.ts",
    "ui-smoke": "tsx tools/ui-smoke.ts",
    "bench": "tsx tools/bench.ts",
    "coverage": "tsx tools/card-coverage.ts",
    "deck-smoke": "tsx tools/deck-smoke.ts",
    "battlefield-smoke": "tsx tools/battlefield-smoke.ts",
    "mobile-smoke": "tsx tools/mobile-smoke.ts",
    "proxy-smoke": "tsx tools/proxy-smoke.ts",
    "server": "tsx packages/server/src/main.ts",
    "build:server": "tsx tools/build-server.ts",
    "online-smoke": "tsx tools/online-smoke.ts",
    "tutorial-smoke": "tsx tools/tutorial-smoke.ts",
    "ai-smoke": "tsx tools/ai-smoke.ts",
    "replay-smoke": "tsx tools/replay-smoke.ts",
    "bo3-smoke": "tsx tools/bo3-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
